%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Title page
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\TitlePageFont}[1]{\textbf{\fontsize{18}{22}\selectfont\uppercase{#1}}}

\def\titlepage{%
  \thispagestyle{empty}%
  \begingroup
  \singlespacing
  \vspace*{23mm}%
  \begin{center}
    \TitlePageFont{\@title}\vfill
    \TitlePageFont{\@author}\vfill
    \TitlePageFont{THIS REPORT IS SUBMITTED IN FULFILMENT OF THE REQUIREMENT FOR THE}\\[0.5ex]
    \TitlePageFont{BACHELOR’S DEGREE IN SCIENCE WITH HONORS}\vfill
    \TitlePageFont{FACULTY OF SCIENCE AND TECHNOLOGY}\\[0.5ex]
    \TitlePageFont{UNIVERSITI MALAYSIA SABAH}\\[1ex]
    \vfill
    \TitlePageFont{\@submitdate}
  \end{center}
  \vspace*{26mm}%
  \endgroup
  \newpage
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Pengesahan
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newlength{\signaturespace}
\setlength{\signaturespace}{.5in}

\def\authorsignature{%
  \begin{minipage}{3in}
    \vspace{\signaturespace}
    \shortstack[l]{\rule[-0.5mm]{2.5in}{.4pt}\\\@author}\\
    Matric No: \@matricno\\
  \end{minipage}
}

\long\def\supervisorsignaturepengesahan{%
  \begin{minipage}{3in}
    \vspace{\signaturespace}
    \shortstack[l]{\rule[-0.5mm]{2.5in}{.4pt}\\(\@mainsupervisor)\\Penyelia Utama}
  \end{minipage}
}

\long\def\pustakawansignaturepengesahan{%
  \begin{minipage}{3in}
    \vspace{\signaturespace}
    \shortstack[l]{\rule[-0.5mm]{2.5in}{.4pt}\\(Tandatangan Pustakawan)}
  \end{minipage}
}

\def\pengesahantesis{%
  \begingroup
  \singlespacing
  \setlength{\parindent}{0pt}%
  \thispagestyle{empty}%
  \begin{center}
    \fontsize{11}{13}\selectfont
    \textbf{UNIVERSITI MALAYSIA SABAH}\\
    BORANG PENGESAHAN STATUS TESIS
  \end{center}
  \begin{flushleft}
    \raisebox{0.5\parskip}{Judul Tesis}\hspace{0.5cm}%
    \framebox[11.5cm]{\parbox[c]{11cm}{\uppercase\expandafter{\@title}}}\par

    Saya \rlap{\rule[-0.5mm]{0.98\textwidth}{.4pt}\hss}\hskip4cm \uppercase\expandafter{\@author}

    \vskip 0.10in

    {\setlength{\baselineskip}{0.7\baselineskip}%
      mengaku membenarkan laporan ini disimpan di Perpustakaan Universiti Malaysia Sabah dengan syarat-syarat kegunaan seperti berikut:\par}

    {\setlength{\baselineskip}{0.3\baselineskip}%
      \begin{enumerate}
        \item Tesis ini adalah hak milik Universiti Malaysia Sabah.
        \item Perpustakaan Universiti Malaysia Sabah dibenarkan membuat salinan untuk tujuan pengajian sahaja.
        \item Perpustakaan dibenarkan membuat salinan tesis ini sebagai bahan pertukaran antara institusi pengajian tinggi.
        \item Sila tandakan ( / )
        \begin{description}
          \item \framebox[1cm]{\raisebox{0.3cm}{}} Sulit \hspace{1.5cm}
            \parbox[t]{0.7\linewidth}{Mengandungi maklumat yang berdarjah keselamatan atau kepentingan Malaysia seperti yang termaktub di dalam AKTA RAHSIA 1972}
          \item \framebox[1cm]{\raisebox{0.3cm}{}} Terhad \hspace{1.1cm}
            \parbox[t]{0.7\linewidth}{Mengandungi maklumat TERHAD yang telah ditentukan oleh organisasi/badan di mana penyelidikan dijalankan}
          \item \framebox[1cm]{\raisebox{0.3cm}{}} Tidak Terhad
        \end{description}
      \end{enumerate}\par}

    \vskip0.4cm
    \begin{tabular}{@{\vspace{-2mm}}l @{\vspace{-2mm}}l}
      \hfill & Disahkan Oleh:\\
      \authorsignature & \raisebox{6.8mm}{\pustakawansignaturepengesahan}\\
      Tarikh: & \raisebox{2mm}{\supervisorsignaturepengesahan}\\
    \end{tabular}\\
    \vfill
  \end{flushleft}
  \endgroup
  \newpage
}

