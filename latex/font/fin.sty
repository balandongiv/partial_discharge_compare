  \testabstract
  \abstractMalayu
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% TOC / LOF / LOT / Abbreviations
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\renewcommand{\cftdot}{}%
\renewcommand{\cftchapfont}{\fontsize{11}{13.6}\selectfont\textbf}
\renewcommand{\cftchappagefont}{\normalsize}
\setlength{\cftbeforechapskip}{0ex}
\setlength{\cftbeforesecskip}{0ex}

\renewcommand{\cftfigname}{\figurename\space}
\renewcommand\cftfigpresnum{{Figure~}}
\setlength{\cftfignumwidth}{2.5cm}

\renewcommand\cfttabpresnum{Table~}
\setlength{\cfttabnumwidth}{2.5cm}

\def\afterpreface{%
  \newpage
  \renewcommand{\cftchappresnum}{CHAPTER }
  \renewcommand{\cftchapnumwidth}{25mm}

  \renewcommand\contentsname{%
    \centering\vspace*{-0.7in}\UMSMajorTitleFont{TABLE OF CONTENTS}%
  }

  \begingroup
  \singlespacing
  \pagestyle{plain}
  \tableofcontents
  \endgroup

  \iffigurespage
    \renewcommand\listfigurename{\centering\vspace*{-1in}\UMSMajorTitleFont{LIST OF FIGURES}}
    \clearpage
    \phantomsection
    \addcontentsline{toc}{chapter}{LIST OF FIGURES}%
    \begingroup\singlespacing\listoffigures\endgroup
  \fi

  \iftablespage
    \renewcommand\listtablename{\centering\vspace*{-1.1in}\UMSMajorTitleFont{LIST OF TABLES}}
    \clearpage
    \phantomsection
    \addcontentsline{toc}{chapter}{LIST OF TABLES}%
    \begingroup\singlespacing\listoftables\endgroup
  \fi

  %%%%%%%%% List of Abbreviations (HEADING GUARANTEED) %%%%%%%%%
  \clearpage
  \chapter*{\vspace*{-1in}\centering\UMSMajorTitleFont{LIST OF ABBREVIATIONS}}
  \phantomsection
  \addcontentsline{toc}{chapter}{LIST OF ABBREVIATIONS}

  \input{./NomenclatureAbbreviations.tex}

  % Prevent listofsymbols from trying to add its own heading
  \renewcommand{\subheading}{}

  \begingroup
    \singlespacing
    \listofsymbolss
  \endgroup
  \clearpage

  \clearpage
  \pagenumbering{arabic}
  \pagestyle{plain}
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Captions (UMS official)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\DeclareCaptionFont{UMScaptionfont}{\bfseries\fontsize{11pt}{13pt}\selectfont}

\captionsetup{
  font=UMScaptionfont,
  justification=centering,
  singlelinecheck=true,
  labelsep=space
}

\captionsetup[figure]{position=bottom, skip=\baselineskip}
\captionsetup[table]{position=top, skip=6pt}
\floatsetup[table]{capposition=top}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Bibliography (APA)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\DeclareLanguageMapping{english}{american-apa}
\addbibresource{BibThesis.bib}

\defbibheading{mybibheading}[\bibname]{%
  \UMSMajorTitleFont{#1}
  \vspace{1em}%
}

\renewcommand{\bibfont}{\normalfont\fontsize{11pt}{13pt}\selectfont}
\setlength\bibitemsep{\baselineskip}
\setlength\bibhang{12.7mm}

\newcommand{\bibliographyAPA}{%
  \clearpage
  \begingroup
  \singlespacing
  \printbibliography[heading=mybibheading, title=REFERENCES]
  \endgroup
  \phantomsection
  \addcontentsline{toc}{chapter}{REFERENCES}%
}

