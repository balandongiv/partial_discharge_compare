\setmainfont{Tahoma}[
  Path = font/,
  Extension = .ttf,
  BoldFont = tahomabd,
]

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Global typography & spacing (per format sheet)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\AtBeginDocument{%
  \doublespacing
}

% Paragraph rules:
% - First line indent 12.7 mm
% - Double spacing between paragraphs
\newlength{\UMSParIndent}
\setlength{\UMSParIndent}{12.7mm}

\AtBeginDocument{%
  \setlength{\parindent}{\UMSParIndent}%
  \setlength{\parskip}{\baselineskip}%
  \justifying
}

% Major title font: 12pt bold (chapter titles & front matter titles)
\newcommand{\UMSMajorTitleFont}{\fontsize{12pt}{14pt}\selectfont\bfseries}

% Regular heading font: 11pt bold
\newcommand{\UMSHeadingFont}{\fontsize{11pt}{13pt}\selectfont\bfseries}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Margins / layout
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\if@twoside
  \setlength\oddsidemargin   {36.1\p@}
  \setlength\evensidemargin  {0\p@}
\else
  \setlength\oddsidemargin   {36.1\p@}
  \setlength\evensidemargin  {36.1\p@}
\fi

\marginparsep 0pt
\setlength{\topmargin}{0in}
\headheight 0pt
\headsep 0pt

\textheight 9.4in
\textwidth 5.77in

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Section numbering depth
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\setcounter{secnumdepth}{3}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Chapter heading style (12pt bold, uppercase)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\def\@thischapterhead{CHAPTER \arabic{chapter}}

\def\@makechapterhead#1{%
  \thispagestyle{empty}%
  {\parindent \z@ \centering
    \begin{center}
      \UMSMajorTitleFont{\@thischapterhead}%
    \end{center}
    \interlinepenalty\@M
    \vskip 24pt
    \UMSMajorTitleFont{\MakeUppercase{#1}}\par\nobreak
    \vskip 36pt
  }%
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Section/Subsection styling (11pt bold) + single spacing for headings
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\renewcommand{\section}{%
  \@startsection{section}{1}{0pt}{36pt plus 6pt minus 6pt}{6pt plus 1pt minus 1pt}%
  {\singlespacing\UMSHeadingFont}%
}

\renewcommand{\subsection}{%
  \@startsection{subsection}{2}{0pt}{36pt plus 6pt minus 6pt}{6pt plus 1pt minus 1pt}%
  {\singlespacing\UMSHeadingFont}%
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Appendix numbering
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\renewcommand{\appendix}{%
  \setcounter{chapter}{0}%
  \renewcommand{\thechapter}{\Alph{chapter}}%
  \renewcommand{\@thischapterhead}{APPENDIX \Alph{chapter}}%
}

\def\appendixchapter#1{%
  \clearpage
  \refstepcounter{chapter}
  \addcontentsline{toc}{chapter}{APPENDIX \Alph{chapter}: #1}%
  \chapter*{\centering
    \vspace*{-30mm}
    {\UMSMajorTitleFont\MakeUppercase{APPENDIX \Alph{chapter}}}\\
    {\UMSHeadingFont\MakeUppercase{#1}}%
  }%
  \nobreak
}

